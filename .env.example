# For a first run, prefer ./bootstrap.sh. It generates a complete .env with
# random secrets and validates the rendered Compose configuration.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
APP_ENV=development
APP_HOST=localhost
SHARE_SENTINEL_STACK=default
SHARE_SENTINEL_IMAGE_TAG=latest
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HTTP_PORT=80
POSTGRES_PASSWORD=replace-before-running-with-a-db-password
JWT_SECRET=replace-before-running-with-a-32-char-secret
JWT_ISSUER=share-sentinel
TOKEN_PEPPER=replace-before-running-with-a-32-char-token-pepper
LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_CIDRS=172.16.0.0/12
ALLOW_SELF_REGISTRATION=false
REQUIRE_USER_FOR_API_TOKEN_CREATE=true
ALLOW_LEGACY_UNSCOPED_TOKENS=false
ALLOW_NEVER_EXPIRING_API_TOKENS=false
DEFAULT_API_TOKEN_EXPIRY_DAYS=90
API_TOKEN_LAST_USED_UPDATE_INTERVAL_SECONDS=300
AUTH_COOKIE_NAME=share_sentinel_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=share_sentinel_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_REFRESH_COOKIE_NAME=share_sentinel_refresh
AUTH_REQUIRE_CSRF=true
UPLOAD_MAX_BYTES=10737418240
UPLOAD_CHUNK_BYTES=8388608
ARTIFACT_STORAGE_MIN_FREE_BYTES=1073741824
ARTIFACT_STORAGE_MIN_FREE_PERCENT=5
RATE_LIMIT_FAIL_OPEN=false
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_STREAM_RETRIES=3
REDIS_STREAM_MAXLEN=250000
MIGRATION_DATABASE_CONNECT_TIMEOUT_SECONDS=10
MIGRATION_DATABASE_LOCK_TIMEOUT_MS=60000
API_DATABASE_POOL_SIZE=10
API_DATABASE_MAX_OVERFLOW=20
API_DATABASE_POOL_TIMEOUT_SECONDS=10
API_DATABASE_POOL_RECYCLE_SECONDS=1800
API_DATABASE_CONNECT_TIMEOUT_SECONDS=5
API_DATABASE_STATEMENT_TIMEOUT_MS=30000
API_DATABASE_LOCK_TIMEOUT_MS=5000
API_RUN_DIFF_MAX_ITEMS=250000
API_COMPARISON_MAX_ACTIVE_PER_PROJECT=3
API_COMPARISON_RATE_LIMIT=12
API_COMPARISON_RATE_WINDOW_SECONDS=60
API_INVENTORY_EXPORT_MAX_CONCURRENT=4
API_INVENTORY_EXPORT_RATE_LIMIT=12
API_INVENTORY_EXPORT_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=900
WORKER_HEALTH_TIMEOUT_SECONDS=45
WORKER_DATABASE_CONNECT_TIMEOUT_SECONDS=5
WORKER_DATABASE_STATEMENT_TIMEOUT_MS=120000
WORKER_DATABASE_LOCK_TIMEOUT_MS=15000
INGEST_MAX_RECORD_BYTES=8388608
INGEST_JSON_COMPAT_MAX_BYTES=52428800
INGEST_GZIP_MAX_BYTES=10737418240
INGEST_RETRY_JITTER_RATIO=0.2
INGEST_MAX_RETRIES=4
INGEST_IDENTITY_CACHE_SIZE=10000
INGEST_PERMISSION_ENTRY_BATCH_SIZE=500
INGEST_PERMISSION_ENTRY_BATCH_MAX_BYTES=8388608
COMPARISON_WORK_QUANTUM_SECONDS=30
COMPARISON_WORK_QUANTUM_BATCHES=20
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false
VITE_API_BASE_URL=/api
VITE_CSRF_COOKIE_NAME=share_sentinel_csrf
VITE_CSRF_HEADER_NAME=x-csrf-token
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me

# Optional collector inputs. Keep secrets empty until a collection run and
# remove them afterwards; bootstrap writes the generated .env with mode 0600.
SHARE_SENTINEL_API_BASE=http://api:8000
SHARE_SENTINEL_PROJECT_ID=
SHARE_SENTINEL_API_TOKEN=
SHARE_SENTINEL_GRAPH_TENANT_ID=
SHARE_SENTINEL_GRAPH_CLIENT_ID=
SHARE_SENTINEL_GRAPH_CLIENT_SECRET=
SHARE_SENTINEL_GRAPH_CLOUD=global
SHARE_SENTINEL_GRAPH_CERTIFICATE_PATH=
SHARE_SENTINEL_GRAPH_CERTIFICATE_THUMBPRINT=
SHARE_SENTINEL_GRAPH_CERTIFICATE_PASSPHRASE=
SHARE_SENTINEL_GRAPH_STATE_PATH=
GRAPH_ACCESS_TOKEN=
